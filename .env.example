# Nope360 — example environment for local development and the developer scripts.
#
# Copy to `.env` (never commit `.env`) or export these in your shell.
# Every value below is a PLACEHOLDER. Do not put a real password in this file.

# ─── Backend target for scripts/ and root utilities ───────────────────────────
# Production backend. Override for staging or a local server.
NOPE360_BACKEND_URL=https://sociallistening-9fvs.onrender.com

# ─── Accounts used by the developer/ops scripts in scripts/ ───────────────────
# Primary admin account.
NOPE360_ADMIN_EMAIL=admin@example.com
NOPE360_ADMIN_PASSWORD=<your-admin-password>

# Secondary, non-admin account (optional; used by RBAC checks).
NOPE360_USER_EMAIL=user@example.com
NOPE360_USER_PASSWORD=<your-user-password>

# Third account (optional; used by a few migration/verification scripts).
NOPE360_ALT_EMAIL=alt@example.com
NOPE360_ALT_PASSWORD=<your-alt-password>

# One-off accounts referenced by individual scripts (optional).
NOPE360_ACCOUNT4_EMAIL=account4@example.com
NOPE360_ACCOUNT4_PASSWORD=<password>
NOPE360_ACCOUNT5_EMAIL=account5@example.com
NOPE360_ACCOUNT5_PASSWORD=<password>
NOPE360_ACCOUNT6_EMAIL=account6@example.com
NOPE360_ACCOUNT6_PASSWORD=<password>
NOPE360_ACCOUNT7_EMAIL=account7@example.com

# ─── check_db.py (direct database inspection utility) ─────────────────────────
# Full connection string. Prefer a read-only role where possible.
NOPE360_DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require
NOPE360_TARGET_EMAIL=someone@example.com
# Only set when you intend to reset that user's password (min 12 characters).
NOPE360_NEW_PASSWORD=<new-password>

# ─── backend/app/scripts/create_admin.py ──────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<a-strong-unique-password-min-12-chars>
ADMIN_FULL_NAME=System Administrator

# ─── Feed ingestion tuning (backend) ──────────────────────────────────────────
# Entries taken per feed per run (default 50, hard cap 200).
CRAWL_MAX_RESULTS_PER_SOURCE=50
# Dev only. Allows the feed fetcher to reach private/loopback addresses.
# NEVER set this in production.
FEED_FETCH_ALLOW_PRIVATE_TARGETS=false
